<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Condition="'$(UsingMicrosoftNETSdkWeb)' == 'true' OR '$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true'">
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" />
    <Compile Include="$(MSBuildThisFileDirectory)Blazor\**\*.cs" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="$(AvaeFeatures.Contains(';AVALONIA;'))">
    <PackageReference Include="Avalonia.Controls.Maui.Essentials"/>
    <PackageReference Include="WindowsContracts.Net.Foundation.UniversalApiContract">
      <PrivateAssets>compile</PrivateAssets>
    </PackageReference>
    <PackageReference Condition="$(IsMacTFM) == 'true'"
                      Include="Microsoft.Maui.Platforms.MacOS.Essentials">
      <PrivateAssets>compile</PrivateAssets>
      <ExcludeAssets>analyzers</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials">
      <!--<PrivateAssets>compile</PrivateAssets>
      <ExcludeAssets>analyzers</ExcludeAssets>-->
    </PackageReference>
    <Compile Include="$(MSBuildThisFileDirectory)Avalonia\**\*.avalonia.cs" Visible="false" />      
  </ItemGroup>

  <Target Name="CopyBlazorAssets" BeforeTargets="BeforeCompile"
        Condition="('$(UsingMicrosoftNETSdkWeb)' == 'true' OR '$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true') AND Exists('$(MSBuildProjectDirectory)\wwwroot')">
    <ItemGroup>
      <_Assets Include="$(MSBuildThisFileDirectory)Blazor\BlazorEssentials.js" />
    </ItemGroup>
    <Copy SourceFiles="@(_Assets)"
          DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\"
          SkipUnchangedFiles="true"
          Condition="Exists('@(_Assets)')" />
  </Target>
</Project>