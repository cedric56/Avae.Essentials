<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <IsLinuxOS Condition="$([MSBuild]::IsOSPlatform('linux'))">true</IsLinuxOS>
    <IsWindowsOS Condition="$([MSBuild]::IsOSPlatform('windows'))">true</IsWindowsOS>
    <IsAndroidTFM>$([System.String]::Copy('$(TargetFramework)').Contains('-android'))</IsAndroidTFM>
    <IsIosTFM>$([System.String]::Copy('$(TargetFramework)').Contains('-ios'))</IsIosTFM>
    <IsMacTFM>$([System.String]::Copy('$(TargetFramework)').Contains('-macos'))</IsMacTFM>
    <IsBrowserTFM>$([System.String]::Copy('$(TargetFramework)').Contains('-browser'))</IsBrowserTFM>
    <IsWindowsTFM>$([System.String]::Copy('$(TargetFramework)').Contains('-windows'))</IsWindowsTFM>
  </PropertyGroup>
  
  <ItemGroup Condition="'$(UsingMicrosoftNETSdkWeb)' == 'true' OR '$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true'">
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" />
    <Compile Include="$(MSBuildThisFileDirectory)..\lib\$(TargetFramework)\Blazor\**\*.cs" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="$(AvaeFeatures.Contains(';AVALONIA;'))">
    <PackageReference Include="Avalonia.Controls.Maui.Essentials"/>
    <PackageReference Include="WindowsContracts.Net.Foundation.UniversalApiContract" PrivateAssets="compile" />
    <PackageReference Condition="$(IsMacTFM) == 'true'" 
                      Include="Microsoft.Maui.Platforms.MacOS.Essentials" />
    <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials" />
    <Compile Include="$(MSBuildThisFileDirectory)..\lib\$(TargetFramework)\Avalonia\**\*.avalonia.cs" Visible="false" />      
  </ItemGroup>

  <Target Name="CopyBlazorAssets" BeforeTargets="BeforeCompile"
        Condition="('$(UsingMicrosoftNETSdkWeb)' == 'true' OR '$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true') AND Exists('$(MSBuildProjectDirectory)\wwwroot')">
    <ItemGroup>
      <_Assets Include="$(MSBuildThisFileDirectory)..\lib\$(TargetFramework)\Blazor\BlazorEssentials.js" />
    </ItemGroup>
    <Copy SourceFiles="@(_Assets)"
          DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\"
          SkipUnchangedFiles="true"
          Condition="Exists('@(_Assets)')" />
  </Target>
</Project>