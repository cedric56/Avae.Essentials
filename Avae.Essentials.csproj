<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>
      net11.0;
      net11.0-browser;
      net11.0-ios;
      net11.0-android;
      net11.0-macos;
      net11.0-windows10.0.19041
    </TargetFrameworks>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Nullable>enable</Nullable>
    <IsLinuxOS Condition="$([MSBuild]::IsOSPlatform('linux'))">true</IsLinuxOS>
    <IsWindowsOS>$([MSBuild]::IsOSPlatform('windows'))</IsWindowsOS>
    <IsAndroidTFM>$([System.String]::Copy('$(TargetFramework)').Contains('-android'))</IsAndroidTFM>
    <IsIosTFM>$([System.String]::Copy('$(TargetFramework)').Contains('-ios'))</IsIosTFM>
    <IsMacTFM>$([System.String]::Copy('$(TargetFramework)').Contains('-macos'))</IsMacTFM>
    <IsBrowserTFM>$([System.String]::Copy('$(TargetFramework)').Contains('-browser'))</IsBrowserTFM>
    <IsWindowsTFM>$([System.String]::Copy('$(TargetFramework)').Contains('-windows'))</IsWindowsTFM>
    <!--<TreatWarningsAsErrors>true</TreatWarningsAsErrors-->
    <IsAotCompatible>true</IsAotCompatible>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0-preview.3</Version>
  </PropertyGroup>
  
  <PropertyGroup>
    <SupportedOSPlatformVersion Condition="'$(IsAndroidTFM)' == 'true'">24</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Conditionally define the symbols -->
  <PropertyGroup>
    <DefineConstants Condition="'$(IsWindowsOS)' == 'true'">$(DefineConstants);WINDOWS_OS</DefineConstants>
    <DefineConstants Condition="'$(IsLinuxOS)' == 'true'">$(DefineConstants);LINUX_OS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Include="build\Avae.Essentials.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Blazor\**\*.*" />
    <TfmSpecificPackageFile Include="Blazor\**\*.*">
      <PackagePath>lib\$(TargetFramework)\Blazor\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </TfmSpecificPackageFile>

    <TfmSpecificPackageFile Include="**\*.avalonia.cs">
      <PackagePath>lib\$(TargetFramework)\Avalonia\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </TfmSpecificPackageFile>
  </ItemGroup>
  
  <!-- Start clean -->
  <ItemGroup>
    <Compile Remove="**\*.browser.cs" />
    <Compile Remove="**\*.avalonia.cs" />
  </ItemGroup>

  <!-- Windows -->
  <ItemGroup Condition="'$(IsWindowsOS)' == 'true' AND '$(IsBrowserTFM)' != 'true' AND '$(IsMacTFM)' != 'true' AND '$(IsAndroidTFM)' != 'true' AND '$(IsIosTFM)' != 'true' AND '$(IsLinuxOS)' != 'true' AND '$(IsWindowsTFM)' != 'true'">
    <PackageReference Include="WindowsContracts.Net.Foundation.UniversalApiContract" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsWindowsTFM)' == 'true'">
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <!-- Browser -->
  <ItemGroup Condition="'$(IsBrowserTFM)' == 'true'">
    <Compile Include="**\*.browser.cs" />
  </ItemGroup>

  <!-- macOS -->
  <ItemGroup Condition="'$(IsMacTFM)' == 'true'">
    <PackageReference Include="Microsoft.Maui.Platforms.MacOS.Essentials" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsLinuxOS)' == 'true'">
    <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials" />
  </ItemGroup>

  <ItemGroup>    
    <PackageReference Include="Microsoft.Maui.Essentials" />
  </ItemGroup>
</Project>
